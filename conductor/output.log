const fs = require('fs');
const content = fs.readFileSync('docs/archive/curriculum/grade3_scope_sequence.md', 'utf-8');

// Split by ## UNIT
const parts = content.split(/## UNIT \d+: /);

const units = [];

for (let i = 1; i < parts.length; i++) {
  const lines = parts[i].split('\n');
  const title = lines[0].trim();
  
  // Extract lessons
  const lessonMatches = parts[i].matchAll(/\*\*Period \d+ \((EI|LAB|FR|SA)\): ([^*]+)\*\*/g);
  const lessons = [];
  for (const m of lessonMatches) {
    const type = m[1];
    const fullTitle = m[2].trim();
    // Generate ID from title
    const id = 'g3-' + fullTitle.toLowerCase()
      .replace(/[^a-z0-9 ]/g, '')
      .replace(/\s+/g, '-')
      .substring(0, 40);
    lessons.push({ type, fullTitle, id });
  }
  
  units.push({ unitNum: i, title, lessons });
}

// Create lesson files for Units 2-10
const lessonTypeToEnum = { 'EI': 'LESSON', 'LAB': 'LAB', 'FR': 'REVIEW', 'SA': 'ASSESSMENT' };

for (const unit of units.filter(u => u.unitNum > 1)) {
  const unitFileName = 'prisma/seed-data/lessons/thai-g3-unit-' + unit.unitNum + '.json';
  
  const lessonsData = {
    framework: 'THAI',
    gradeLevel: 3,
    unit: unit.unitNum,
    lessons: unit.lessons.map((l, idx) => ({
      id: l.id,
      title: l.fullTitle + ' / ' + l.fullTitle,
      description: 'Grade 3 ' + unit.title + ' - ' + l.fullTitle,
      lessonType: lessonTypeToEnum[l.type] || 'LESSON',
      content: '# ' + l.fullTitle + '\\n\\nLesson content for ' + l.fullTitle + '.',
      order: idx + 1,
      standards: [],
      structuredContent: {
        version: 1,
        blocks: [
          {
            id: 'intro',
            type: 'text',
            content: 'Welcome to the lesson on ' + l.fullTitle + '.'
          }
        ]
      }
    }))
  };
  
  fs.writeFileSync(unitFileName, JSON.stringify(lessonsData, null, 2));
  console.log('Created:', unitFileName, '-', lessonsData.lessons.length, 'lessons');
}

console.log('\\nDone! Created lesson files for Units 2-10');
