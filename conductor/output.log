const fs = require('fs');
const content = fs.readFileSync('docs/archive/curriculum/grade3_scope_sequence.md', 'utf-8');

// Split by ## UNIT 
const sections = content.split(/(?=## UNIT \d+:)/);

const units = [];
for (let i = 1; i < sections.length; i++) {
  const section = sections[i];
  
  // Extract unit number and title
  const headerMatch = section.match(/## UNIT (\d+): ([^\n]+)\n\n\*\*Weeks ([^|]+)\| ([^ ]+) \*\*/);
  if (!headerMatch) continue;
  
  const unitNum = parseInt(headerMatch[1]);
  const title = headerMatch[2].trim();
  const weeks = headerMatch[3].trim();
  const periods = headerMatch[4].trim();
  
  // Extract lessons - Period X (TYPE): Title
  const lessonMatches = section.matchAll(/\*\*Period (\d+) \((EI|LAB|FR|SA)\): ([^\n*]+)\*\*/g);
  const lessons = [];
  for (const m of lessonMatches) {
    lessons.push({
      period: parseInt(m[1]),
      type: m[2],
      title: m[3].trim()
    });
  }
  
  units.push({ unitNum, title, weeks, periods, lessons });
}

// Print summary
units.forEach(u => {
  const ei = u.lessons.filter(l => l.type === 'EI').length;
  const lab = u.lessons.filter(l => l.type === 'LAB').length;
  const fr = u.lessons.filter(l => l.type === 'FR').length;
  const sa = u.lessons.filter(l => l.type === 'SA').length;
  console.log('Unit ' + u.unitNum + ': ' + u.title + ' (' + u.weeks + ', ' + u.periods + ')');
  console.log('  EI:' + ei + ' LAB:' + lab + ' FR:' + fr + ' SA:' + sa + ' = ' + u.lessons.length + ' lessons');
});
console.log('\\nTotal units:', units.length);
console.log('Total lessons:', units.reduce((sum, u) => sum + u.lessons.length, 0));
