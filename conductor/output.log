  const unitSection = content.slice(match.index, content.indexOf('## UNIT ' + (parseInt(unitNum) + 1), match.index) || content.length);
  const lessonRegex = /\*\*Period (\d+) \((EI|LAB|FR|SA)\): ([^\n]+)\*\*/g;
  const lessons = [];
