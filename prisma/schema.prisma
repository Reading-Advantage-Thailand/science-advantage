generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user {
  id            String    @id
  name          String
  username      String    @unique
  displayUsername String  @unique
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(STUDENT)
  gradeLevel    Int?
  createdAt     DateTime
  updatedAt     DateTime
  account       account[]
  session       session[]
  taughtClasses Class[]   @relation("ClassTeacher")
  enrolledClass Class[]   @relation("ClassStudents")
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// Curriculum and Class Management Models

enum StandardsAlignment {
  THAI
  NGSS
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  SYSTEM
}

model Class {
  id                  String             @id @default(cuid())
  name                String
  gradeLevel          Int
  standardsAlignment  StandardsAlignment
  teacherId           String
  teacher             user               @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  students            user[]             @relation("ClassStudents")
  curriculumUnits     CurriculumUnit[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([teacherId])
  @@index([gradeLevel])
  @@index([standardsAlignment])
}

model Standard {
  id          String             @id @default(cuid())
  framework   StandardsAlignment
  code        String
  description String
  gradeLevel  Int?
  lessons     Lesson[]

  @@unique([framework, code])
  @@index([framework])
  @@index([gradeLevel])
}

model Lesson {
  id                String    @id @default(cuid())
  title             String
  description       String?
  content           String?
  gradeLevel        Int
  order             Int
  standards         Standard[]
  curriculumUnits   CurriculumUnit[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([gradeLevel])
  @@index([order])
}

model CurriculumUnit {
  id          String             @id @default(cuid())
  title       String
  description String?
  framework   StandardsAlignment
  gradeLevel  Int
  order       Int
  lessons     Lesson[]
  classId     String
  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([classId, framework, order])
  @@index([classId])
  @@index([framework])
  @@index([gradeLevel])
}
