import fs from 'fs';

const questionsDir = './prisma/data/content/grade-4/questions';

const files = fs.readdirSync(questionsDir).filter(f => f.endsWith('.json'));
const fixedFiles: string[] = [];

for (const file of files) {
  const data = JSON.parse(fs.readFileSync(questionsDir + '/' + file, 'utf-8'));
  let modified = false;
  
  for (const q of data.questions) {
    if (q.slug === undefined) {
      // Convert q1 to q-1, q2 to q-2, etc
      const num = q.id.replace(/^q/, '');
      q.slug = 'q-' + num;
      modified = true;
    }
  }
  
  if (modified) {
    fs.writeFileSync(questionsDir + '/' + file, JSON.stringify(data, null, 2));
    fixedFiles.push(file);
  }
}

console.log('Fixed', fixedFiles.length, 'files:');
fixedFiles.forEach(f => console.log('  -', f));
