import { LessonContentSchema } from './lib/schemas/lesson-content.schema.ts';
import { validateQuestionSlug } from './lib/schemas/lesson-slug.schema.ts';
import fs from 'fs';

const lessonsDir = './prisma/data/content/grade-4/lessons';
const questionsDir = './prisma/data/content/grade-4/questions';

const lessonFiles = fs.readdirSync(lessonsDir).filter(f => f.endsWith('.json'));
const questionFiles = fs.readdirSync(questionsDir).filter(f => f.endsWith('.json'));

console.log('Checking', lessonFiles.length, 'lesson files...');
const lessonErrors = [];
for (const file of lessonFiles) {
  try {
    const data = JSON.parse(fs.readFileSync(lessonsDir + '/' + file, 'utf-8'));
    LessonContentSchema.parse(data);
  } catch (e) {
    lessonErrors.push(file + ': ' + e.message.substring(0, 100));
  }
}
console.log('Lesson errors:', lessonErrors.length);
lessonErrors.slice(0, 3).forEach(e => console.log('  -', e));

console.log('\\nChecking', questionFiles.length, 'question files...');
const questionErrors = [];
for (const file of questionFiles) {
  try {
    const data = JSON.parse(fs.readFileSync(questionsDir + '/' + file, 'utf-8'));
    if (!data.lessonId) throw new Error('Missing lessonId');
    if (!Array.isArray(data.questions)) throw new Error('Missing questions array');
    for (const q of data.questions) {
      if (!q.slug) throw new Error('Question missing slug: ' + q.id);
      validateQuestionSlug(q.slug);
      if (q.questionThai === undefined) throw new Error('Question missing questionThai: ' + q.id);
    }
  } catch (e) {
    questionErrors.push(file + ': ' + e.message.substring(0, 100));
  }
}
console.log('Question errors:', questionErrors.length);
questionErrors.slice(0, 3).forEach(e => console.log('  -', e));
