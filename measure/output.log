import { LessonContentSchema } from './lib/schemas/lesson-content.schema';
import { validateQuestionSlug } from './lib/schemas/lesson-slug.schema';
import fs from 'fs';

const seedLessonsDir = './prisma/seed-data/lessons';
const seedQuestionsDir = './prisma/seed-data/questions';

const lessonFiles = fs.readdirSync(seedLessonsDir).filter(f => f.endsWith('.json'));
const questionFiles = fs.readdirSync(seedQuestionsDir).filter(f => f.endsWith('.json'));

console.log('=== Grade 3 Seed Lesson Validation ===');
let lessonPass = 0, lessonFail = 0;
for (const file of lessonFiles) {
  try {
    const data = JSON.parse(fs.readFileSync(seedLessonsDir + '/' + file, 'utf-8'));
    // Check if it has blocks (structured lesson format)
    if (!data.blocks) {
      console.log('SKIP (no blocks):', file);
      continue;
    }
    LessonContentSchema.parse(data);
    lessonPass++;
  } catch (e: any) {
    lessonFail++;
    console.log('FAIL:', file, e.message.substring(0, 100));
  }
}
console.log('Lessons with blocks:', lessonPass, 'passed,', lessonFail, 'failed');

console.log('\\n=== Grade 3 Seed Question Validation ===');
let questionPass = 0, questionFail = 0;
const questionErrors: string[] = [];
for (const file of questionFiles) {
  try {
    const data = JSON.parse(fs.readFileSync(seedQuestionsDir + '/' + file, 'utf-8'));
    if (!data.lessonId && !data.unitId) throw new Error('Missing lessonId or unitId');
    const questions = data.questions || data.quiz?.questions;
    if (!Array.isArray(questions)) throw new Error('Missing questions array');
    for (const q of questions) {
      if (!q.slug && !q.id) throw new Error('Question missing id/slug');
      if (q.slug) validateQuestionSlug(q.slug);
      if (q.questionThai === undefined && q.question) console.log('  WARN:', file, 'q', q.id || q.slug, 'missing questionThai');
    }
    questionPass++;
  } catch (e: any) {
    questionFail++;
    questionErrors.push(file + ': ' + e.message);
  }
}
console.log('Questions:', questionPass, 'passed,', questionFail, 'failed');
questionErrors.slice(0, 5).forEach(e => console.log('  FAIL:', e));
