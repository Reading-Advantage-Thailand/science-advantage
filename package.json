{
  "name": "science-advantage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "echo 'E2E tests not yet configured'",
    "seed": "tsx prisma/seed.ts",
    "seed:demo-users": "tsx prisma/seed-demo-users.ts",
    "dev:reset": "npx prisma db push --force-reset && npm run seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
