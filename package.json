    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/ui": "^3.2.4",
    "eslint-config-next": "16.0.0",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "prisma-zod-generator": "^1.29.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
